generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum UserRole {
  ADMIN
  PETERNAK
  PASAR_HEWAN
  JAGAL
  RPH
  DISTRIBUTOR
  HOREKA
  END_CUSTOMER
  REGULATOR
}

enum EntityType {
  PETERNAK
  PASAR_HEWAN
  JAGAL
  RPH
  DISTRIBUTOR
  HOREKA
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  CANCELLED
}

// MODELS

model User {
  id        String   @id @default(uuid())
  username  String
  email     String   @unique
  password  String
  role      UserRole
  profile   Profile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id          String     @id @default(uuid())
  entityType  EntityType
  fotoProfil  String?    // Tambahan foto profil
  user        User       @relation(fields: [userId], references: [id])
  userId      String     @unique

  peternakId    String?  @unique
  peternak      Peternak? @relation(fields: [peternakId], references: [id])
  
  pasarHewanId  String?  @unique
  pasarHewan    PasarHewan? @relation(fields: [pasarHewanId], references: [id])
  
  jagalId       String?  @unique
  jagal         Jagal?   @relation(fields: [jagalId], references: [id])
  
  rphId         String?  @unique
  rph           RPH?     @relation(fields: [rphId], references: [id])
  
  distributorId String?  @unique
  distributor   Distributor? @relation(fields: [distributorId], references: [id])
  
  horekaId      String?  @unique
  horeka        Horeka?  @relation(fields: [horekaId], references: [id])
  
  endCustomerId String?  @unique
  endCustomer   EndCustomer? @relation(fields: [endCustomerId], references: [id])
  
  regulatorId   String?  @unique
  regulator     Regulator? @relation(fields: [regulatorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Regulator {
  id       String   @id @default(uuid())
  nama     String
  instansi String
  jabatan  String
  userId   String?  @unique
  rphId    String   // Relasi dengan RPH yang dipantau

  rphs              RPH[]                @relation("RegulatorRPH")  // Daftar RPH yang dipantau oleh regulator
  profiles          Profile[]            // Profil yang terkait dengan Regulator
  itemChecklistHalal ItemChecklistHalal[] // Checklist yang dibuat oleh Regulator
}

model Peternak {
  id             String     @id @unique
  nama           String
  alamat         String
  noTelepon      String
  jumlahSapi     Int        @default(0)
  sertifikatNKV  String?
  
  sapi           Sapi[]
  profiles       Profile[]
}

model PasarHewan {
  id             String     @id @default(uuid())
  nama           String
  alamat         String
  noTelepon      String
  jumlahSapi     Int        @default(0)
  sertifikatNKV  String?
  userId         String?    @unique
  
  sapi           Sapi[]
  profiles       Profile[]
}

model Jagal {
  id             String     @id @default(uuid())
  nama           String
  alamat         String
  noTelepon      String
  jumlahSapi     Int        @default(0)
  jumlahDaging   Int        @default(0)
  sertifikatNKV  String?
  userId         String?    @unique

  sapi           Sapi[]
  daging         Daging[]
  transaksiPenyembelihan TransaksiPenyembelihan[]
  profiles       Profile[]
}

model RPH {
  id                     String     @id @default(uuid())
  nama                   String
  alamat                 String
  noTelepon              String
  sertifikatNKV          String?
  sertifikatHalal        String?
  namaJuleha             String?
  noSertifJuleha         String?
  jumlahPenyelia         Int        @default(0)
  userId                 String?    @unique

  regulatorId            String?    // Relasi ke Regulator
  regulator              Regulator? @relation("RegulatorRPH", fields: [regulatorId], references: [id])

  daging                 Daging[]  // Daftar daging yang diproses oleh RPH
  transaksiPenyembelihan TransaksiPenyembelihan[]  // Transaksi penyembelihan di RPH
  profiles               Profile[]  // Profil yang terkait dengan RPH
}

model Distributor {
  id                    String     @id @default(uuid())
  namaUsaha             String
  alamat                String
  noTelepon             String
  kondisiProduk         String?
  fasilitasPenyimpanan  String?
  userId                String?    @unique

  daging                Daging[]   // Daging yang dimiliki Distributor
  profiles              Profile[]
}

model Horeka {
  id            String     @id @default(uuid())
  nama          String
  alamat        String
  noTelepon     String
  kondisiProduk String?
  userId        String?    @unique

  daging        Daging[]   // Daging yang dimiliki Horeka
  profiles      Profile[]
}

model EndCustomer {
  id        String   @id @default(uuid())
  nama      String
  alamat    String
  noTelepon String
  userId    String?  @unique

  daging    Daging[] // Daging yang dimiliki End Customer
  profiles  Profile[]
}

model Sapi {
  id                     String     @id @default(uuid())
  usia                   Int
  jenis                  String
  kelamin                String
  beratSapi              Float?     // Tambahan berat sapi
  asalType               EntityType
  asalId                 String
  
  peternakId             String?
  peternak               Peternak? @relation(fields: [peternakId], references: [id])
  
  pasarHewanId           String?
  pasarHewan             PasarHewan? @relation(fields: [pasarHewanId], references: [id])

  jagalId                String?
  jagal                  Jagal? @relation(fields: [jagalId], references: [id])
  
  // Flag untuk tracking sapi sudah diproses menjadi daging
  isProcessed            Boolean    @default(false)
  processedAt            DateTime?
  
  daging                 Daging?
  transaksiPenyembelihan TransaksiPenyembelihan[]
  transaksiPenjualan     TransaksiPenjualan[]
  pengecekanSehat        PengecekanSehat[]
  pengecekanHalalSehat   PengecekanHalalSehat[]
  qr                     QR[]
}

model Daging {
  id                     String     @id @default(uuid())
  sapiId                 String     @unique
  sapi                   Sapi       @relation(fields: [sapiId], references: [id])
  jagalId                String     // Owner jagal dari sapi ini
  jagal                  Jagal      @relation(fields: [jagalId], references: [id])
  rphId                  String     // RPH yang melakukan penyembelihan
  rph                    RPH        @relation(fields: [rphId], references: [id])
  
  // Tracking kepemilikan saat ini (nullable karena awalnya milik Jagal)
  distributorId          String?    // Distributor pemilik saat ini
  distributor            Distributor? @relation(fields: [distributorId], references: [id])
  
  horekaId               String?    // Horeka pemilik saat ini
  horeka                 Horeka?    @relation(fields: [horekaId], references: [id])
  
  endCustomerId          String?    // End Customer pemilik saat ini
  endCustomer            EndCustomer? @relation(fields: [endCustomerId], references: [id])
  
  sudahDijual            Boolean    @default(false) // Flag apakah sudah dijual
  
  // Detail paket daging
  beratDaging            Float      // Berat daging (kg)
  beratJeroan            Float      // Berat jeroan (kg) 
  beratTulang            Float      // Berat tulang (kg)
  totalBerat             Float      // Total berat paket
  
  // Relasi ke transaksi penyembelihan
  transaksiPenyembelihan TransaksiPenyembelihan?
  
  // Verifikasi bersama Jagal dan Regulator
  verifikasiJagal        Boolean    @default(false)
  verifikasiRegulator    Boolean    @default(false)
  
  // Status verifikasi halal
  statusHalal            VerificationStatus @default(PENDING)
  kodeVerifikasiHalal    String?    // Kode verifikasi antara RPH dan Regulator
  verifiedAt             DateTime?  // Timestamp kapan daging terverifikasi halal
  
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  
  transaksiPenjualan     TransaksiPenjualan[]
  qr                     QR[]
}

// Model untuk menyimpan item checklist halal yang dibuat oleh Regulator
model ItemChecklistHalal {
  id          String   @id @default(uuid())
  pertanyaan  String   // Pertanyaan checklist
  tipe        String   // "PRA_PENYEMBELIHAN" atau "PASCA_PENYEMBELIHAN"
  kategori    String?  // Kategori pertanyaan (opsional)
  urutan      Int      @default(0) // Urutan tampilan
  isAktif     Boolean  @default(true) // Apakah item ini aktif
  
  regulatorId String?  // Regulator yang membuat item ini
  regulator   Regulator? @relation(fields: [regulatorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relasi ke jawaban checklist
  jawaban     ChecklistPenyembelihan[]
}

// Model untuk jawaban checklist per transaksi penyembelihan
model ChecklistPenyembelihan {
  id                         String   @id @default(uuid())
  
  transaksiPenyembelihanId   String
  transaksiPenyembelihan     TransaksiPenyembelihan @relation(fields: [transaksiPenyembelihanId], references: [id], onDelete: Cascade)
  
  itemChecklistId            String
  itemChecklist              ItemChecklistHalal @relation(fields: [itemChecklistId], references: [id])
  
  isChecked                  Boolean  @default(false) // Apakah item ini sudah dicek
  catatan                    String?  // Catatan tambahan dari RPH
  
  checkedBy                  String?  // User ID yang melakukan checklist
  checkedAt                  DateTime? // Waktu pengecekan
  
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  
  @@unique([transaksiPenyembelihanId, itemChecklistId])
}

model TransaksiPenyembelihan {
  id              String     @id @default(uuid())
  
  // Jagal yang mendaftarkan sapi untuk disembelih
  jagalId         String
  jagal           Jagal      @relation(fields: [jagalId], references: [id])
  
  // RPH tujuan penyembelihan
  rphId           String
  rph             RPH        @relation(fields: [rphId], references: [id])
  
  sapiId          String
  sapi            Sapi       @relation(fields: [sapiId], references: [id])
  
  // Status transaksi dengan flow yang lebih detail
  status          String     @default("PENDING_RPH") 
  // Status flow:
  // - PENDING_RPH: Menunggu RPH menerima
  // - CHECKLIST_PRA: RPH sedang mengisi checklist pra-penyembelihan
  // - READY_TO_SLAUGHTER: Checklist pra lolos, siap disembelih
  // - SLAUGHTERING: Sedang proses penyembelihan
  // - CHECKLIST_PASCA: Mengisi checklist pasca-penyembelihan
  // - PENDING_INPUT_HASIL: Checklist pasca lolos, menunggu input berat
  // - PENDING_JAGAL_VERIFICATION: Menunggu verifikasi Jagal
  // - PENDING_REGULATOR_VERIFICATION: Menunggu verifikasi Regulator
  // - VERIFIED: Terverifikasi lengkap
  // - REJECTED: Ditolak
  
  // Tanggal milestone
  tanggalPendaftaran     DateTime @default(now())
  tanggalChecklistPra    DateTime? // Kapan checklist pra selesai
  tanggalPenyembelihan   DateTime? // Kapan proses penyembelihan
  tanggalChecklistPasca  DateTime? // Kapan checklist pasca selesai
  tanggalInputHasil      DateTime? // Kapan RPH input hasil
  
  // Hasil checklist
  checklistPraLengkap    Boolean  @default(false)
  checklistPascaLengkap  Boolean  @default(false)
  
  // Data hasil penyembelihan (diisi oleh RPH)
  beratDaging     Float?
  beratJeroan     Float?
  beratTulang     Float?
  totalBerat      Float?
  
  // Verification tracking
  verificationCode    String?
  jagalVerifiedAt     DateTime?
  regulatorVerifiedAt DateTime?
  processedAt         DateTime?
  
  // IPFS and tracking
  timestamp       DateTime   @default(now())
  cid             String?
  
  // Relasi ke daging (dibuat setelah pemrosesan)
  dagingId        String?    @unique
  daging          Daging?    @relation(fields: [dagingId], references: [id])
  
  // Relasi ke checklist
  checklist       ChecklistPenyembelihan[]
}

model TransaksiPenjualan {
  id                String     @id @default(uuid())
  penjualType       EntityType
  penjualId         String
  pembeliType       EntityType
  pembeliId         String
  
  sapiId            String?
  sapi              Sapi?     @relation(fields: [sapiId], references: [id])
  
  dagingId          String?
  daging            Daging?   @relation(fields: [dagingId], references: [id])
  
  jumlahQty         Int
  type              String
  timestamp         DateTime  @default(now())
  cid               String     @default("")
  verifikasiPenjual Boolean   @default(false)
  verifikasiPembeli Boolean   @default(false)
  verifikasiRegulator Boolean @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verificationCode   String?
  notes             String?
}

model PengecekanSehat {
  id          String     @id @default(uuid())
  sapiId      String
  sapi        Sapi       @relation(fields: [sapiId], references: [id])
  
  itemSehatId String
  itemSehat   ItemSehat  @relation(fields: [itemSehatId], references: [id])
  
  boolean     Boolean
  cid         String
}

model ItemSehat {
  id        String     @id @default(uuid())
  nama      String
  deskripsi String?
  kategori  String?
  
  pengecekan PengecekanSehat[]
}

model PengecekanHalalSehat {
  id              String     @id @default(uuid())
  sapiId          String
  sapi            Sapi       @relation(fields: [sapiId], references: [id])
  
  itemHalalSehatId String
  itemHalalSehat   ItemHalalSehat @relation(fields: [itemHalalSehatId], references: [id])
  
  boolean         Boolean
  cid             String
}

model ItemHalalSehat {
  id        String     @id @default(uuid())
  nama      String
  deskripsi String?
  kategori  String?
  
  pengecekan PengecekanHalalSehat[]
}

model QR {
  id          String     @id @default(uuid())
  
  sapiId      String?
  sapi        Sapi?      @relation(fields: [sapiId], references: [id])
  
  dagingId    String?
  daging      Daging?    @relation(fields: [dagingId], references: [id])
  
  urlQR       String
}